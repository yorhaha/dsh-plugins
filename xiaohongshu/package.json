{
  "name": "dsh-xhs-reader",
  "version": "0.1.0",
  "description": "Xiaohongshu reading for DeepSeek Harness: a cookie in the local credential store, signed read-only search and note tools, bounded low-frequency requests, and a local image corpus.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./web/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "web",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node tests/verify-behavior.mjs && node ../verify-client-datetime.mjs xiaohongshu && node ../verify-client-locales.mjs xiaohongshu"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "xiaohongshu",
    "xhs",
    "rednote",
    "reading",
    "cookie",
    "tools"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}
